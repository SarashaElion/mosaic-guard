{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic-guard.dev/schema/inference-boundary.schema.json",
  "title": "Inference Boundary Protocol Policy",
  "type": "object",
  "required": ["version", "purpose"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^0\\.1(?:\\..*)?$"
    },
    "purpose": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["id"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "allowed_inferences": { "$ref": "#/$defs/stringSet" },
    "restricted_inferences": { "$ref": "#/$defs/stringSet" },
    "denied_inferences": { "$ref": "#/$defs/stringSet" },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "rule": {
      "type": "object",
      "required": ["id", "when_all", "infer"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "when_all": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "infer": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
